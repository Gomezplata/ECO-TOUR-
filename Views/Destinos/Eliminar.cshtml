@model Destino
@{
    ViewData["Title"] = "Eliminar destino";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h2 class="mb-3">¿Eliminar este destino?</h2>

        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@Model.Nombre</h5>
                <p class="card-text">@Model.Descripcion</p>
                <p class="mb-0">@Moneda.Pesos(Model.PrecioPorPersona) por persona · @Model.Reservas.Count reserva(s)</p>
            </div>
        </div>

        @if (Model.Reservas.Count > 0)
        {
            <div class="alert alert-warning">
                Este destino tiene reservas, por eso no se puede eliminar. Primero elimina o cambia esas reservas.
            </div>
            <a class="btn btn-secondary" asp-action="Index">Volver</a>
        }
        else
        {
            <form asp-action="Eliminar" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
            </form>
        }
    </div>
</div>
