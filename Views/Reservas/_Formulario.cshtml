@model Reserva
@{
    var destinos = (List<Destino>)ViewBag.Destinos;
}

<div class="mb-3">
    <label asp-for="NombreTurista" class="form-label"></label>
    <input asp-for="NombreTurista" class="form-control" />
    <span asp-validation-for="NombreTurista" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Correo" class="form-label"></label>
    <input asp-for="Correo" class="form-control" />
    <span asp-validation-for="Correo" class="text-danger"></span>
</div>

<!-- Lista desplegable con los destinos que vienen de la base de datos.
     El value de cada opción es el Id del destino, que se guarda en DestinoId (clave foránea) -->
<div class="mb-3">
    <label asp-for="DestinoId" class="form-label"></label>
    <select asp-for="DestinoId" class="form-select">
        <option value="0">Selecciona un destino</option>
        @foreach (var d in destinos)
        {
            <option value="@d.Id" data-precio="@d.PrecioPorPersona">@d.Nombre - @Moneda.Pesos(d.PrecioPorPersona)</option>
        }
    </select>
    <span asp-validation-for="DestinoId" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-12 col-sm-6 mb-3">
        <label asp-for="Personas" class="form-label"></label>
        <input asp-for="Personas" class="form-control" min="1" max="10" />
        <span asp-validation-for="Personas" class="text-danger"></span>
    </div>
    <div class="col-12 col-sm-6 mb-3">
        <label asp-for="Fecha" class="form-label"></label>
        <input asp-for="Fecha" type="date" class="form-control" />
        <span asp-validation-for="Fecha" class="text-danger"></span>
    </div>
</div>

<div id="estimado" class="alert alert-info">
    Elige un destino y entre 1 y 10 personas para ver el total estimado.
</div>
